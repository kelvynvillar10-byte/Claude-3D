{
 "duracao_s": 112.29,
 "frases": [
  {
   "n": 1,
   "intencao": "misterio",
   "nome": "Mistério",
   "texto": "Imagine acordar amanhã…",
   "ini": 0.15,
   "fim": 1.82
  },
  {
   "n": 2,
   "intencao": "surpresa",
   "nome": "Surpresa",
   "texto": "e descobrir que você tem apenas cinco centímetros de altura.",
   "ini": 2.32,
   "fim": 6.78
  },
  {
   "n": 3,
   "intencao": "curiosidade",
   "nome": "Curiosidade",
   "texto": "Sua cama seria como um prédio.",
   "ini": 7.13,
   "fim": 9.11
  },
  {
   "n": 4,
   "intencao": "curiosidade",
   "nome": "Curiosidade",
   "texto": "Seu celular pareceria uma televisão gigante.",
   "ini": 9.41,
   "fim": 12.6
  },
  {
   "n": 5,
   "intencao": "curiosidade",
   "nome": "Curiosidade",
   "texto": "E até sair do quarto poderia se transformar em uma missão impossível.",
   "ini": 12.9,
   "fim": 17.98
  },
  {
   "n": 6,
   "intencao": "suspense",
   "nome": "Suspense",
   "texto": "Mas o pior ainda estaria por vir…",
   "ini": 18.43,
   "fim": 20.92
  },
  {
   "n": 7,
   "intencao": "curiosidade",
   "nome": "Curiosidade",
   "texto": "Com apenas cinco centímetros, uma simples gota de água poderia parecer uma enorme esfera.",
   "ini": 21.52,
   "fim": 28.21
  },
  {
   "n": 8,
   "intencao": "curiosidade",
   "nome": "Curiosidade",
   "texto": "Uma moeda no chão seria quase um obstáculo gigante.",
   "ini": 28.59,
   "fim": 31.82
  },
  {
   "n": 9,
   "intencao": "curiosidade",
   "nome": "Curiosidade",
   "texto": "E aquela escada que você sobe todos os dias?",
   "ini": 32.12,
   "fim": 34.74
  },
  {
   "n": 10,
   "intencao": "descoberta",
   "nome": "Descoberta/revelação",
   "texto": "Agora seria uma sequência de montanhas que você precisaria escalar.",
   "ini": 35.14,
   "fim": 39.29
  },
  {
   "n": 11,
   "intencao": "suspense",
   "nome": "Suspense",
   "texto": "Mas existe um perigo ainda maior: os animais da sua própria casa.",
   "ini": 39.84,
   "fim": 43.96
  },
  {
   "n": 12,
   "intencao": "tensao",
   "nome": "Tensão",
   "texto": "Uma formiga poderia parecer um adversário enorme.",
   "ini": 44.56,
   "fim": 47.01
  },
  {
   "n": 13,
   "intencao": "suspense",
   "nome": "Suspense",
   "texto": "E um gato curioso, que antes parecia inofensivo, agora seria um verdadeiro predador.",
   "ini": 47.46,
   "fim": 53.33
  },
  {
   "n": 14,
   "intencao": "suspense",
   "nome": "Suspense",
   "texto": "Um único movimento errado…",
   "ini": 53.78,
   "fim": 54.98
  },
  {
   "n": 15,
   "intencao": "tensao",
   "nome": "Tensão",
   "texto": "e você poderia acabar em uma situação desesperadora.",
   "ini": 55.58,
   "fim": 59.19
  },
  {
   "n": 16,
   "intencao": "surpresa",
   "nome": "Surpresa",
   "texto": "Só que existe algo ainda mais curioso: seu corpo não funcionaria exatamente como antes.",
   "ini": 59.74,
   "fim": 65.58
  },
  {
   "n": 17,
   "intencao": "explicacao",
   "nome": "Explicação",
   "texto": "Ao diminuir de tamanho, seu peso cairia muito mais rapidamente do que sua força muscular.",
   "ini": 65.93,
   "fim": 71.61
  },
  {
   "n": 18,
   "intencao": "descoberta",
   "nome": "Descoberta/revelação",
   "texto": "Isso significa que, proporcionalmente, você poderia ser muito mais forte do que um humano normal.",
   "ini": 71.96,
   "fim": 77.44
  },
  {
   "n": 19,
   "intencao": "suspense",
   "nome": "Suspense",
   "texto": "Mas isso não resolveria todos os seus problemas.",
   "ini": 77.89,
   "fim": 79.91
  },
  {
   "n": 20,
   "intencao": "tensao",
   "nome": "Tensão",
   "texto": "Uma pequena poça poderia dificultar sua passagem.",
   "ini": 80.41,
   "fim": 81.49
  },
  {
   "n": 21,
   "intencao": "tensao",
   "nome": "Tensão",
   "texto": "Uma corrente de ar poderia desequilibrar você.",
   "ini": 81.69,
   "fim": 84.65
  },
  {
   "n": 22,
   "intencao": "tensao",
   "nome": "Tensão",
   "texto": "E até encontrar comida e água se tornaria um desafio.",
   "ini": 84.85,
   "fim": 87.82
  },
  {
   "n": 23,
   "intencao": "suspense",
   "nome": "Suspense",
   "texto": "O mundo continuaria exatamente igual…",
   "ini": 88.27,
   "fim": 90.03
  },
  {
   "n": 24,
   "intencao": "descoberta",
   "nome": "Descoberta/revelação",
   "texto": "mas tudo ao seu redor teria se transformado em um obstáculo gigantesco.",
   "ini": 90.43,
   "fim": 93.09
  },
  {
   "n": 25,
   "intencao": "suspense",
   "nome": "Suspense",
   "texto": "E sabe qual seria a parte mais assustadora?",
   "ini": 93.64,
   "fim": 96.45
  },
  {
   "n": 26,
   "intencao": "emocao",
   "nome": "Emoção",
   "texto": "Você não estaria em um mundo diferente.",
   "ini": 97.0,
   "fim": 99.68
  },
  {
   "n": 27,
   "intencao": "emocao",
   "nome": "Emoção",
   "texto": "Estaria exatamente no mesmo mundo de sempre…",
   "ini": 100.13,
   "fim": 103.77
  },
  {
   "n": 28,
   "intencao": "descoberta",
   "nome": "Descoberta/revelação",
   "texto": "Só que, dessa vez, seria você quem teria se tornado pequeno demais para ele.",
   "ini": 104.37,
   "fim": 109.86
  },
  {
   "n": 29,
   "intencao": "conclusao",
   "nome": "Conclusão",
   "texto": "MODO CURIOSO.",
   "ini": 110.36,
   "fim": 111.79
  }
 ],
