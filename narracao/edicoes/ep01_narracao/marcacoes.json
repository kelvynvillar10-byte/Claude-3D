{
 "duracao_s": 110.22,
 "frases": [
  {
   "n": 1,
   "intencao": "misterio",
   "nome": "Mistério",
   "texto": "Imagine acordar amanhã…",
   "ini": 0.15,
   "fim": 1.79
  },
  {
   "n": 2,
   "intencao": "surpresa",
   "nome": "Surpresa",
   "texto": "e descobrir que você tem apenas 5 centímetros de altura.",
   "ini": 2.29,
   "fim": 6.75
  },
  {
   "n": 3,
   "intencao": "curiosidade",
   "nome": "Curiosidade",
   "texto": "Sua cama seria como um prédio, seu celular pareceria uma televisão gigante, e até sair do quarto poderia se transformar em uma missão impossível.",
   "ini": 7.1,
   "fim": 17.62
  },
  {
   "n": 4,
   "intencao": "suspense",
   "nome": "Suspense",
   "texto": "Mas o pior ainda estaria por vir…",
   "ini": 18.07,
   "fim": 20.56
  },
  {
   "n": 5,
   "intencao": "curiosidade",
   "nome": "Curiosidade",
   "texto": "Com apenas 5 centímetros, uma simples gota de água poderia se tornar um obstáculo enorme.",
   "ini": 21.16,
   "fim": 27.85
  },
  {
   "n": 6,
   "intencao": "curiosidade",
   "nome": "Curiosidade",
   "texto": "Uma moeda no chão seria quase uma montanha.",
   "ini": 28.15,
   "fim": 31.38
  },
  {
   "n": 7,
   "intencao": "curiosidade",
   "nome": "Curiosidade",
   "texto": "E aquela escada que você sobe todos os dias?",
   "ini": 31.68,
   "fim": 34.3
  },
  {
   "n": 8,
   "intencao": "descoberta",
   "nome": "Descoberta/revelação",
   "texto": "Agora seria uma sequência de paredões que você precisaria escalar.",
   "ini": 34.93,
   "fim": 38.83
  },
  {
   "n": 9,
   "intencao": "suspense",
   "nome": "Suspense",
   "texto": "Mas existe um perigo ainda maior: os animais da sua própria casa.",
   "ini": 39.38,
   "fim": 43.5
  },
  {
   "n": 10,
   "intencao": "tensao",
   "nome": "Tensão",
   "texto": "Uma aranha poderia parecer assustadora.",
   "ini": 44.1,
   "fim": 46.55
  },
  {
   "n": 11,
   "intencao": "suspense",
   "nome": "Suspense",
   "texto": "E um gato curioso, que antes parecia inofensivo, agora seria um verdadeiro predador.",
   "ini": 47.0,
   "fim": 53.73
  },
  {
   "n": 12,
   "intencao": "suspense",
   "nome": "Suspense",
   "texto": "Um único movimento errado…",
   "ini": 54.18,
   "fim": 56.09
  },
  {
   "n": 13,
   "intencao": "tensao",
   "nome": "Tensão",
   "texto": "e você poderia estar em perigo.",
   "ini": 56.54,
   "fim": 58.43
  },
  {
   "n": 14,
   "intencao": "surpresa",
   "nome": "Surpresa",
   "texto": "Só que existe algo ainda mais curioso: seu corpo também mudaria de comportamento.",
   "ini": 58.98,
   "fim": 64.82
  },
  {
   "n": 15,
   "intencao": "explicacao",
   "nome": "Explicação",
   "texto": "Ao diminuir de tamanho, seu peso cairia muito mais rapidamente do que a força dos seus músculos.",
   "ini": 65.17,
   "fim": 70.85
  },
  {
   "n": 16,
   "intencao": "descoberta",
   "nome": "Descoberta/revelação",
   "texto": "Isso faria você ficar proporcionalmente mais forte em relação ao próprio peso.",
   "ini": 71.2,
   "fim": 76.47
  },
  {
   "n": 17,
   "intencao": "suspense",
   "nome": "Suspense",
   "texto": "Mas não significa que seria invencível.",
   "ini": 76.92,
   "fim": 79.83
  },
  {
   "n": 18,
   "intencao": "tensao",
   "nome": "Tensão",
   "texto": "Uma corrente de ar poderia desequilibrar você.",
   "ini": 80.33,
   "fim": 83.31
  },
  {
   "n": 19,
   "intencao": "tensao",
   "nome": "Tensão",
   "texto": "Uma poça poderia dificultar sua passagem, e até encontrar comida e água se tornaria um desafio.",
   "ini": 83.51,
   "fim": 91.02
  },
  {
   "n": 20,
   "intencao": "suspense",
   "nome": "Suspense",
   "texto": "E sabe qual seria a parte mais assustadora?",
   "ini": 91.57,
   "fim": 94.38
  },
  {
   "n": 21,
   "intencao": "emocao",
   "nome": "Emoção",
   "texto": "Você não estaria em um mundo diferente.",
   "ini": 94.93,
   "fim": 97.59
  },
  {
   "n": 22,
   "intencao": "emocao",
   "nome": "Emoção",
   "texto": "Estaria exatamente no mesmo mundo de sempre…",
   "ini": 98.31,
   "fim": 101.7
  },
  {
   "n": 23,
   "intencao": "descoberta",
   "nome": "Descoberta/revelação",
   "texto": "Só que, dessa vez, seria você quem teria se tornado pequeno demais para ele.",
   "ini": 102.3,
   "fim": 107.79
  },
  {
   "n": 24,
   "intencao": "conclusao",
   "nome": "Conclusão",
   "texto": "MODO CURIOSO.",
   "ini": 108.29,
   "fim": 109.72
  }
 ],
