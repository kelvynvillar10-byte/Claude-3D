{
 "duracao_s": 85.86,
 "frases": [
  {
   "n": 1,
   "intencao": "curiosidade",
   "nome": "Curiosidade",
   "texto": "E se sua namorada chegasse em casa com uma surpresa que mudaria sua vida para sempre?",
   "ini": 0.15,
   "fim": 3.95
  },
  {
   "n": 2,
   "intencao": "explicacao",
   "nome": "Explicação",
   "texto": "Juca estava tranquilamente no sofá quando ela apareceu segurando uma caixa enorme.",
   "ini": 4.49,
   "fim": 8.24
  },
  {
   "n": 3,
   "intencao": "entusiasmo",
   "nome": "Entusiasmo",
   "texto": "Ao abrir, ele encontrou um PlayStation 5 novinho em folha!",
   "ini": 8.54,
   "fim": 11.65
  },
  {
   "n": 4,
   "intencao": "suspense",
   "nome": "Suspense",
   "texto": "Mas espera...",
   "ini": 12.1,
   "fim": 12.75
  },
  {
   "n": 5,
   "intencao": "entusiasmo",
   "nome": "Entusiasmo",
   "texto": "tinha mais uma surpresa!",
   "ini": 13.35,
   "fim": 14.58
  },
  {
   "n": 6,
   "intencao": "entusiasmo",
   "nome": "Entusiasmo",
   "texto": "GTA 6 já estava instalado!",
   "ini": 14.83,
   "fim": 16.37
  },
  {
   "n": 7,
   "intencao": "descoberta",
   "nome": "Descoberta/revelação",
   "texto": "Naquele instante, Juca descobriu o verdadeiro significado da felicidade.",
   "ini": 16.97,
   "fim": 21.58
  },
  {
   "n": 8,
   "intencao": "explicacao",
   "nome": "Explicação",
   "texto": "Seus olhos brilharam, seu coração acelerou e ele abraçou o videogame como se tivesse encontrado um tesouro perdido.",
   "ini": 22.03,
   "fim": 27.83
  },
  {
   "n": 9,
   "intencao": "surpresa",
   "nome": "Surpresa",
   "texto": "Ele simplesmente não conseguia acreditar naquilo!",
   "ini": 28.33,
   "fim": 30.61
  },
  {
   "n": 10,
   "intencao": "explicacao",
   "nome": "Explicação",
   "texto": "Juca ligou o console, pegou o controle e começou sua aventura em Vice City.",
   "ini": 30.96,
   "fim": 35.0
  },
  {
   "n": 11,
   "intencao": "explicacao",
   "nome": "Explicação",
   "texto": "Cada carro, cada rua e cada detalhe do jogo pareciam incríveis.",
   "ini": 35.3,
   "fim": 39.39
  },
  {
   "n": 12,
   "intencao": "suspense",
   "nome": "Suspense",
   "texto": "Ele estava tão impressionado que nem percebeu o tempo passando.",
   "ini": 39.99,
   "fim": 43.28
  },
  {
   "n": 13,
   "intencao": "descoberta",
   "nome": "Descoberta/revelação",
   "texto": "Duas horas depois, a namorada percebeu que ele ainda estava jogando.",
   "ini": 43.88,
   "fim": 47.45
  },
  {
   "n": 14,
   "intencao": "explicacao",
   "nome": "Explicação",
   "texto": "Cinco horas depois, a comida já estava fria.",
   "ini": 47.9,
   "fim": 50.41
  },
  {
   "n": 15,
   "intencao": "explicacao",
   "nome": "Explicação",
   "texto": "Dez horas depois, Juca continuava exatamente no mesmo lugar.",
   "ini": 50.71,
   "fim": 54.41
  },
  {
   "n": 16,
   "intencao": "explicacao",
   "nome": "Explicação",
   "texto": "O sofá já parecia ter se tornado sua nova residência oficial.",
   "ini": 54.71,
   "fim": 58.23
  },
  {
   "n": 17,
   "intencao": "surpresa",
   "nome": "Surpresa",
   "texto": "Quando amanheceu, Juca ainda estava jogando.",
   "ini": 58.53,
   "fim": 60.76
  },
  {
   "n": 18,
   "intencao": "descoberta",
   "nome": "Descoberta/revelação",
   "texto": "A namorada começou a perceber que aquele presente talvez tivesse sido um dos maiores erros da sua vida.",
   "ini": 61.36,
   "fim": 66.45
  },
  {
   "n": 19,
   "intencao": "suspense",
   "nome": "Suspense",
   "texto": "Afinal, ela queria agradar o namorado...",
   "ini": 66.9,
   "fim": 69.1
  },
  {
   "n": 20,
   "intencao": "entusiasmo",
   "nome": "Entusiasmo",
   "texto": "Mas acabou criando um verdadeiro morador de Vice City!",
   "ini": 69.7,
   "fim": 72.16
  },
  {
   "n": 21,
   "intencao": "suspense",
   "nome": "Suspense",
   "texto": "E o mais impressionante?",
   "ini": 72.41,
   "fim": 73.42
  },
  {
   "n": 22,
   "intencao": "surpresa",
   "nome": "Surpresa",
   "texto": "Juca ainda estava na primeira missão!",
   "ini": 74.02,
   "fim": 75.71
  },
  {
   "n": 23,
   "intencao": "suspense",
   "nome": "Suspense",
   "texto": "Agora imagine receber um presente desses...",
   "ini": 76.21,
   "fim": 78.19
  },
  {
   "n": 24,
   "intencao": "curiosidade",
   "nome": "Curiosidade",
   "texto": "Você conseguiria desligar o videogame para dar atenção à sua namorada?",
   "ini": 78.79,
   "fim": 82.15
  },
  {
   "n": 25,
   "intencao": "curiosidade",
   "nome": "Curiosidade",
   "texto": "Ou também desapareceria da vida real para morar em Vice City?",
   "ini": 82.53,
   "fim": 85.36
  }
 ],
